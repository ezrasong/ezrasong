<% if (plugins.calendar) {
  const { totalContributions, weeks, months, longestStreak, busiestDay } = plugins.calendar;
  const colors = { NONE: '#161b22', FIRST_QUARTILE: '#0e4429', SECOND_QUARTILE: '#006d32', THIRD_QUARTILE: '#26a641', FOURTH_QUARTILE: '#39d353' };
  const start = 31;
  const pitch = 14;
%>
  <section class="profile-calendar">
    <h2 class="field">Contribution calendar</h2>
    <p class="profile-calendar-summary"><%= totalContributions %> contributions in the last year</p>
    <svg class="profile-calendar-grid" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 <%= start + weeks.length * pitch + 12 %> 116" role="img" aria-label="Daily GitHub contributions over the last year">
      <% for (const { column, name } of months) { %>
        <text x="<%= start + column * pitch %>" y="12"><%= name %></text>
      <% } %>
      <% for (const [weekday, name] of [[1, 'Mon'], [3, 'Wed'], [5, 'Fri']]) { %>
        <text x="0" y="<%= 27 + weekday * pitch %>"><%= name %></text>
      <% } %>
      <% for (const [column, { contributionDays }] of weeks.entries()) { %>
        <% for (const { date, weekday, contributionCount, contributionLevel } of contributionDays) { %>
          <rect x="<%= start + column * pitch %>" y="<%= 18 + weekday * pitch %>" width="11" height="11" rx="2" fill="<%= colors[contributionLevel] %>"><title><%= date %> · <%= contributionCount %> contributions</title></rect>
        <% } %>
      <% } %>
    </svg>
    <div class="profile-calendar-footer">
      <span>Longest streak <%= longestStreak %> days · Busiest day <%= busiestDay %> contributions</span>
      <span class="profile-calendar-legend">
        Less
        <% for (const color of Object.values(colors)) { %>
          <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><rect width="10" height="10" rx="2" fill="<%= color %>" /></svg>
        <% } %>
        More
      </span>
    </div>
  </section>
<% } %>
